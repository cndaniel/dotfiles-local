export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8

# Keep Oh My Zsh for compatibility, but use a lightweight plugin set.
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="ys"
plugins=(git)
if [[ -o interactive && -t 0 && -t 1 && -s "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
fi

# De-emphasize legacy Ruby/Rails defaults from shared dotfiles.
unalias b migrate s 2>/dev/null || true

alias zshconfig="$EDITOR ~/.zshrc.local"
alias ohmyzsh="~/.oh-my-zsh"

export SSH_KEY="$HOME/.ssh/rsa_id"
export GOPATH="$HOME/go"

typeset -U path
path=("$HOME/go/bin" "${path[@]}")

if [ -s /usr/local/opt/asdf/asdf.sh ]; then
  source /usr/local/opt/asdf/asdf.sh
elif [ -s /opt/homebrew/opt/asdf/asdf.sh ]; then
  source /opt/homebrew/opt/asdf/asdf.sh
fi

# History and safety
HISTSIZE=100000
SAVEHIST=100000
setopt share_history hist_ignore_all_dups hist_reduce_blanks inc_append_history
setopt RM_STAR_WAIT

# FZF defaults
if [ -f "$HOME/.fzf.zsh" ]; then
  source "$HOME/.fzf.zsh"
fi
export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border'
if command -v fd >/dev/null 2>&1; then
  export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
fi

# Modern terminal helpers
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi
if command -v direnv >/dev/null 2>&1; then
  eval "$(direnv hook zsh)"
fi

if [[ -o interactive && -t 0 && -t 1 ]]; then
  if command -v atuin >/dev/null 2>&1; then
    eval "$(atuin init zsh --disable-up-arrow)"
  fi

  if command -v brew >/dev/null 2>&1; then
    _brew_prefix="$(brew --prefix)"

    if [ -f "$_brew_prefix/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]; then
      source "$_brew_prefix/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
    fi

    # Must be loaded near the end.
    if [ -f "$_brew_prefix/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]; then
      source "$_brew_prefix/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
    fi

    unset _brew_prefix
  fi
fi

# Prompt priority: starship first, existing prompt/theme fallback.
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

# Unified AI CLI entrypoint.
: "${AI_DEFAULT_TOOL:=opencode}"
ai() {
  local tool

  if [[ $# -eq 0 || "$1" == -* ]]; then
    tool="$AI_DEFAULT_TOOL"
  else
    tool="$1"
    shift
  fi

  case "$tool" in
    opencode|amp|codex|claude)
      ;;
    *)
      echo "ai: unknown tool '$tool'" >&2
      echo "usage: ai [opencode|amp|codex|claude] [args...]" >&2
      return 2
      ;;
  esac

  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "ai: '$tool' is not installed or not in PATH" >&2
    return 127
  fi

  command "$tool" "$@"
}

# Remove shared repo-relative path entry, then re-add trusted repo bin paths.
path=("${path[@]:#.git/safe/../../bin}")
if command -v git >/dev/null 2>&1; then
  _safe_repo_bin() {
    local root
    root="$(git rev-parse --show-toplevel 2>/dev/null)" || return 0
    path=("${path[@]:#${root}/bin}")
    if [ -d "$root/.git/safe" ] && [ -d "$root/bin" ]; then
      path=("$root/bin" "${path[@]}")
    fi
  }

  autoload -U add-zsh-hook
  add-zsh-hook chpwd _safe_repo_bin
  _safe_repo_bin
fi

_tmux_repo_root() {
  command -v git >/dev/null 2>&1 || return 1
  git rev-parse --show-toplevel 2>/dev/null || return 1
}

_tmux_session_name() {
  local root name
  root="$(_tmux_repo_root 2>/dev/null || print -r -- "$PWD")"
  name="${root:t}"

  if [[ "$root" == "$HOME" ]]; then
    name="home"
  fi

  name="${name//[^A-Za-z0-9._-]/-}"
  name="${name:l}"
  [[ -z "$name" ]] && name="shell"
  print -r -- "$name"
}

_tmux_ensure_session() {
  local name root
  name="$(_tmux_session_name)"
  root="$(_tmux_repo_root 2>/dev/null || print -r -- "$PWD")"

  tmux has-session -t "$name" 2>/dev/null && return 0

  tmux new-session -d -s "$name" -c "$root" -n main
  tmux select-window -t "$name:1"
}

_tmux_supported_terminal() {
  case "${TERM_PROGRAM:-}" in
    WarpTerminal|vscode)
      return 1
      ;;
  esac

  case "${TERMINAL_EMULATOR:-}" in
    JetBrains-JediTerm)
      return 1
      ;;
  esac

  return 0
}

_tmux_auto_attach() {
  [[ -o interactive ]] || return 0
  [[ -t 0 && -t 1 ]] || return 0
  command -v tmux >/dev/null 2>&1 || return 0
  [[ -n "$TMUX" ]] && return 0
  [[ -n "$NO_AUTO_TMUX" ]] && return 0
  _tmux_supported_terminal || return 0

  _tmux_ensure_session || return 0
  tmux -2 attach -t "$(_tmux_session_name)" >/dev/null 2>&1 || true
}

_tmux_auto_attach
