##### Terminal and colors (True Color support)
set -g default-terminal "tmux-256color"
set -ga terminal-overrides ",xterm-256color:Tc"

##### Key behavior
setw -g mode-keys vi
set -g status-keys emacs
set -g mouse on

##### Prefix: use C-a as the only prefix, free C-b
set -g prefix C-a

# When nested tmux: prefix + C-a sends prefix to the inner tmux
bind-key C-a send-prefix

##### Pane navigation, Vim style (prefix + h/j/k/l)
bind-key h select-pane -L
bind-key j select-pane -D
bind-key k select-pane -U
bind-key l select-pane -R

##### Window navigation (prefix + Ctrl+h/l)
bind-key -r C-h select-window -t :-
bind-key -r C-l select-window -t :+

##### Indexing and window renumbering
set -g base-index 1
setw -g pane-base-index 1
set -g renumber-windows on

##### Scrollback (larger buffer for AI output)
set -g history-limit 50000

##### Status bar
set -g status-interval 1
set -g status-style bg="#666666",fg="#aaaaaa"
set -g status-left-length 50
set -g status-right-length 40
set -g status-left "#[fg=yellow]#{?client_prefix,PFX ,}#[fg=white,bold]#S #[fg=#aaaaaa]| #[fg=#ffffff]#W#[default]"
set -g status-right "#[fg=#cccccc]%Y-%m-%d %H:%M #[default]"

# Highlight active window
setw -g window-status-current-style bg=white,fg=black

##### Reload config (prefix + r)
bind-key r source-file ~/.tmux.conf \; display-message "~/.tmux.conf reloaded"

##### Splits, keep current working directory
bind-key '-' split-window -v -c "#{pane_current_path}"
bind-key \\ split-window -h -c "#{pane_current_path}"
bind-key '|' split-window -v -c "#{pane_current_path}"

##### New window in current working directory (prefix + c)
bind-key c new-window -c "#{pane_current_path}"

##### Resize panes without prefix
# Fine adjustment
bind -n S-Left  resize-pane -L 2
bind -n S-Right resize-pane -R 2
bind -n S-Down  resize-pane -D 1
bind -n S-Up    resize-pane -U 1

# Coarse adjustment
bind -n C-Left  resize-pane -L 10
bind -n C-Right resize-pane -R 10
bind -n C-Down  resize-pane -D 5
bind -n C-Up    resize-pane -U 5

##### Pane management
bind-key b break-pane -d

##### Layout presets (one key)
# Three (or more) panes as columns (left-to-right)
bind-key V select-layout even-vertical
# Three (or more) panes as rows (top-to-bottom)
bind-key H select-layout even-horizontal

# Swap current pane with a target pane number
bind-key s display-panes \; command-prompt -p "pane #: " "swap-pane -t '%%'"

##### Session management shortcuts
bind-key C-l list-sessions
bind-key C-j choose-tree

##### Copy mode mouse wheel behavior
bind -n WheelUpPane if -F "#{mouse_any_flag}" "send-keys -M" "if -F '#{pane_in_mode}' 'send-keys -M' 'copy-mode -e'"

##### Copy mode, Vim-like selection and clipboard
bind-key -T copy-mode-vi v send -X begin-selection

# macOS clipboard support, with graceful fallback when
# reattach-to-user-namespace is absent
bind-key -T copy-mode-vi y if-shell -b "command -v reattach-to-user-namespace >/dev/null 2>&1" "send -X copy-pipe-and-cancel 'reattach-to-user-namespace pbcopy'" "send -X copy-pipe-and-cancel 'pbcopy'"

unbind -T copy-mode-vi Enter
bind-key -T copy-mode-vi Enter if-shell -b "command -v reattach-to-user-namespace >/dev/null 2>&1" "send -X copy-pipe-and-cancel 'reattach-to-user-namespace pbcopy'" "send -X copy-pipe-and-cancel 'pbcopy'"

##### Smart pane switching with Vim awareness (vim-tmux-navigator style)
is_vim="ps -o state= -o comm= -t '#{pane_tty}' | grep -iqE '^[^TXZ ]+(\\S+/)?g?(view|n?vim?x?)(diff)?$'"

bind-key -n C-h if-shell "$is_vim" "send-keys C-h" "select-pane -L"
bind-key -n C-j if-shell "$is_vim" "send-keys C-j" "select-pane -D"
bind-key -n C-k if-shell "$is_vim" "send-keys C-k" "select-pane -U"
bind-key -n C-l if-shell "$is_vim" "send-keys C-l" "select-pane -R"
bind -n C-\\ if-shell "$is_vim" "send-keys 'C-\\'" "select-pane -l"

bind-key -T copy-mode-vi C-h select-pane -L
bind-key -T copy-mode-vi C-j select-pane -D
bind-key -T copy-mode-vi C-k select-pane -U
bind-key -T copy-mode-vi C-l select-pane -R

##### Safety tweaks
unbind-key C-z

# Confirm before killing current session (prefix + K)
bind-key K confirm-before -p "Kill session #S? (y/n)" "run-shell 'tmux switch-client -n 2>/dev/null; tmux kill-session -t \"#S\"'"

# Optional: keep your tat shortcut, safer form (prefix + T)
bind-key T run-shell "command -v tat >/dev/null 2>&1 && tat || true"

##### Local config chaining (if you want to keep it)
# if-shell "[ -f ~/.tmux.conf.local ]" "source ~/.tmux.conf.local"

# ============================================
# Plan 2: Tmux enhancements
# ============================================

##### TPM Plugins
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'

# tmux-resurrect configuration
set -g @resurrect-capture-pane-contents 'on'
set -g @resurrect-strategy-vim 'session'

# tmux-continuum configuration
set -g @continuum-restore 'on'
set -g @continuum-save-interval '15'

##### Initialize TPM (keep this at the bottom)
if-shell "[ -f ~/.tmux/plugins/tpm/tpm ]" "run '~/.tmux/plugins/tpm/tpm'"
